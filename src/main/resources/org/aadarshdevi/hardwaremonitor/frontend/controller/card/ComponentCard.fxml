<Button fx:id="button_project" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" mnemonicParsing="false" prefHeight="70.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <graphic>
      <BorderPane prefHeight="50.0" prefWidth="460.0">
         <bottom>
            <Label fx:id="label_filepath" text="Data Format" BorderPane.alignment="CENTER_LEFT" />
         </bottom>
         <left>
            <Label fx:id="label_name" text="Component Name" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </Label>
         </left>
         <right>
            <Button fx:id="button_options" mnemonicParsing="false" prefHeight="30.0" prefWidth="30.0" BorderPane.alignment="CENTER">
               <graphic>
                  <SVGPath />
               </graphic>
               <contextMenu>
                  <ContextMenu>
                    <items>
                      <MenuItem mnemonicParsing="false" text="Edit" />
